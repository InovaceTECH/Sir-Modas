# Neon PostgreSQL (use a pooled connection string in the application)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Neon Auth - configure when the Neon project is provisioned
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Vercel Blob - configure when product photo uploads are implemented
BLOB_READ_WRITE_TOKEN=

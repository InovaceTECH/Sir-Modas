# Desenvolvimento local com `docker compose up -d database`
# DATABASE_URL=postgresql://sirmodas:sirmodas_local@localhost:5434/sirmodas

# Neon PostgreSQL para publicação (use uma conexão pooled)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Conexão direta do Neon, usada somente por migrations e tarefas administrativas.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Better Auth - gere com: npx auth@latest secret
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Habilite somente durante a criação da primeira proprietária.
# Depois do primeiro acesso, altere para false na Vercel e localmente.
AUTH_ALLOW_SIGN_UP=false

# Ignora o login somente em desenvolvimento e em localhost.
# Esta opção é bloqueada automaticamente em builds de produção.
AUTH_BYPASS_LOCAL=false

# Vercel Blob - reservado para a futura implementação de upload de fotos
BLOB_READ_WRITE_TOKEN=
